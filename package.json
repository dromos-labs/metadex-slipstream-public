{
  "name": "@aero/slipstream",
  "version": "1.0.1",
  "description": "Metadex Slipstream Core Contracts",
  "keywords": [
    "aero",
    "slipstream"
  ],
  "homepage": "https://aero.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dromos-labs/metadex-slipstream-public.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "files": [
    "contracts/core/interfaces",
    "contracts/core/libraries",
    "contracts/periphery/base",
    "contracts/periphery/interfaces",
    "contracts/periphery/libraries",
    "artifacts/contracts/core/CLFactory.sol/CLFactory.json",
    "artifacts/contracts/core/CLPool.sol/CLPool.json",
    "artifacts/contracts/core/libraries/CLPoolNonSwapPath.sol/CLPoolNonSwapPath.json",
    "artifacts/contracts/core/interfaces/**/*.json",
    "!artifacts/contracts/core/interfaces/**/*.dbg.json",
    "artifacts/contracts/periphery/**/*.json",
    "!artifacts/contracts/periphery/**/*.dbg.json",
    "!artifacts/contracts/periphery/test/**/*",
    "!artifacts/contracts/periphery/base/**/*"
  ],
  "scripts": {
    "build": "forge build",
    "compile": "hardhat compile",
    "fmt:check": "forge fmt --check",
    "lint:natspec": "lintspec",
    "lint:slither": "FOUNDRY_EVM_VERSION=istanbul slither --solc-solcs-select 0.7.6",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "prepare": "husky"
  },
  "lint-staged": {
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "@nomad-xyz/excessively-safe-call": "0.0.1-rc.1",
    "@openzeppelin/contracts": "3.4.2-solc-0.7",
    "@uniswap/lib": "4.0.1-alpha",
    "base64-sol": "1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@nomicfoundation/hardhat-ethers": "4.0.11",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.8",
    "@nomicfoundation/hardhat-ignition": "3.1.5",
    "@nomicfoundation/hardhat-ignition-ethers": "3.1.5",
    "@nomicfoundation/hardhat-keystore": "3.0.9",
    "@nomicfoundation/hardhat-mocha": "3.0.19",
    "@nomicfoundation/hardhat-network-helpers": "3.0.8",
    "@nomicfoundation/hardhat-node-test-runner": "3.0.15",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.5",
    "@nomicfoundation/hardhat-typechain": "3.0.9",
    "@nomicfoundation/hardhat-verify": "3.0.17",
    "@openzeppelin/contracts-v5": "npm:@openzeppelin/contracts@5.6.1",
    "@types/chai": "5.2.3",
    "@types/mocha": "5.2.7",
    "@types/node": "22.19.18",
    "chai": "5.3.3",
    "decimal.js": "10.2.1",
    "dotenv": "14.3.2",
    "ethers": "6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.10.0",
    "hardhat": "3.4.5",
    "husky": ">=9",
    "is-svg": "4.4.0",
    "lint-staged": "^16.0.0",
    "mocha": "11.7.5",
    "mocha-chai-jest-snapshot": "1.1.1",
    "prettier": "2.8.8",
    "prettier-plugin-solidity": "1.0.0-beta.2",
    "solady": "0.1.1",
    "solhint": "3.3.2",
    "solhint-community": "4.0.1",
    "solhint-config-wonderland": "0.0.1",
    "solhint-plugin-prettier": "0.0.5",
    "sort-package-json": "3.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.10.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
